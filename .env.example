# ─────────────────────────────────────────────────────────────────────────────
#  TCE Smart Complaint Portal — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Web App → Config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Cloudinary (replaces Firebase Storage — free tier) ────────────────────────
# 1. Sign up at https://cloudinary.com (free)
# 2. Dashboard → Settings → Upload → Upload Presets → Add Unsigned Preset
# 3. Set preset name below (e.g. tce_portal_unsigned)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tce_portal_unsigned

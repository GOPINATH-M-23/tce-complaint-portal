rules_version = '2';

/**
 * TCE Smart Complaint Portal — Firestore Security Rules
 *
 * Architecture:
 *   Writes that need business logic (submit, update, student create) go through
 *   Netlify Functions which use the Firebase Admin SDK — bypassing these rules.
 *   These rules are the LAST LINE OF DEFENCE for any direct client writes.
 *
 * Principle of least privilege:
 *   - Students can only read/write their own data
 *   - Admins can read everything but cannot delete
 *   - No unauthenticated access to any document
 *   - All sensitive mutations are server-side only
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isAuth()   { return request.auth != null; }
    function uid()      { return request.auth.uid; }

    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/admins/$(uid()));
    }

    function isStudent() {
      return isAuth() &&
        exists(/databases/$(database)/documents/students/$(uid()));
    }

    function studentData() {
      return get(/databases/$(database)/documents/students/$(uid())).data;
    }

    function isActiveStudent() {
      return isStudent() && studentData().active == true;
    }

    function ownStudentId() {
      return studentData().studentId;
    }

    // Validate that only allowed fields are being written
    function onlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ── Health check collection (functions use this) ──────────────────────────
    match /_health/{doc} {
      allow read: if false; // Only Firebase Admin SDK (server) reads this
    }

    // ── Admins collection ─────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read:   if isAdmin() || uid() == adminId;
      allow write:  if false; // Only Firebase Admin SDK can write admin docs
    }

    // ── Students collection ───────────────────────────────────────────────────
    match /students/{studentId} {
      // Admin can read all students
      allow read:   if isAdmin();
      // Student can read their own profile
      allow read:   if uid() == studentId;

      // Self-registration (Google OAuth creates doc on first sign-in)
      allow create: if uid() == studentId &&
                       request.resource.data.uid == uid() &&
                       request.resource.data.active == true &&
                       request.resource.data.keys().hasAll(['uid','name','email','studentId','active']);

      // Students can update limited fields on their own profile (e.g. photoURL refresh)
      allow update: if uid() == studentId &&
                       onlyFields(['photoURL', 'phone', 'regNo']);

      // Admin creates/updates via Netlify Function (Admin SDK) — bypasses rules
      allow write:  if false; // Covered by Admin SDK bypass
    }

    // ── Complaints collection ─────────────────────────────────────────────────
    match /complaints/{complaintId} {
      // Allow read access for public portal aggregate stats & admin/student dashboard
      allow read: if true;

      // Student complaint submission — direct write allowed but restricted
      // Preferred: use Netlify Function (submit-complaint) for full validation
      // This rule is a fallback with strict field validation
      allow create: if isActiveStudent() &&
                       request.resource.data.studentId   == ownStudentId()     &&
                       request.resource.data.status       == 'Submitted'        &&
                       request.resource.data.adminReply   == ''                 &&
                       request.resource.data.imageUrl     == ''                 &&
                       request.resource.data.read         == false              &&
                       request.resource.data.keys().hasAll([
                         'title','category','description','status','priority',
                         'studentId','studentName','studentEmail','dept',
                         'adminReply','imageUrl','imagePublicId','read','createdAt','updatedAt'
                       ]);

      // Students can update ONLY imageUrl on their OWN submitted complaints
      // (image uploaded after complaint creation)
      allow update: if isActiveStudent() &&
                       resource.data.studentId == ownStudentId()  &&
                       resource.data.status    == 'Submitted'      &&
                       onlyFields(['imageUrl', 'imagePublicId', 'updatedAt']);

      // Admin updates allowed for authenticated admins or via Admin SDK
      allow update: if isAdmin();

      // Nobody can delete complaints
      allow delete: if false;
    }

    // ── Notifications collection ──────────────────────────────────────────────
    match /notifications/{notifId} {
      // Student can read their own notifications or admin broadcast notifications
      allow read:   if (isActiveStudent() && (resource.data.userId == ownStudentId() || resource.data.createdBy == 'admin'))
                       || isAdmin();

      // Admin can create, update, delete notifications
      allow create, update, delete: if isAdmin();

      // Students can mark their own notifications as read (update only 'read' field)
      allow update: if isActiveStudent()                        &&
                       resource.data.userId == ownStudentId()   &&
                       onlyFields(['read']);
    }
  }
}

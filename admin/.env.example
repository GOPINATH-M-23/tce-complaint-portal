# ─────────────────────────────────────────────────────────────────────────────
#  TCE Smart Complaint Portal — Environment Variables
#
#  FRONTEND vars:  prefix VITE_   → bundled into client JS (public)
#  BACKEND vars:   no prefix      → Netlify function env only (secret)
#
#  Copy this file to .env for local dev.
#  On Netlify: Site Settings → Environment Variables → add each key.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (frontend — public config is safe per Firebase design) ───────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Cloudinary (frontend — cloud name only, no secret) ───────────────────────
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# UPLOAD_PRESET is now server-side only — never expose to client

# ── Cloudinary (backend — NEVER expose to client) ────────────────────────────
# Cloudinary Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Firebase Admin SDK (backend — NEVER expose to client) ────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_UPLOADS=10
RATE_LIMIT_WINDOW_MS=900000

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://your-site.netlify.app
NODE_ENV=production
